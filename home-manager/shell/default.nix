# Терминальное окружение одним куском: оболочка, эмулятор терминала,
# мультиплексор и поиск. Настройки связаны между собой — биндинги zsh
# сверены с terminfo foot, fzf цепляется к zsh интеграцией — поэтому
# правятся обычно вместе.
{
  imports = [
    ./foot.nix
    ./fzf.nix
    ./tmux.nix
    ./zsh.nix
  ];
}
